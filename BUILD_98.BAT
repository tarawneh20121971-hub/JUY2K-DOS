@ECHO OFF
SETLOCAL EnableExtensions

SET "ROOT=%~dp0"
SET "NASM=%ROOT%tools\nasm-3.02\nasm.exe"
SET "SRC=%ROOT%src\variants\JUY2KC98.ASM"
SET "OUTDIR=%ROOT%bin\98"
SET "RESDIR=%ROOT%tests\results\JUY2KC98"
SET "OUT=%OUTDIR%\JUY2KC98.COM"
SET "TMP=%OUTDIR%\JUY2KC98.TMP"
SET "LST=%RESDIR%\JUY2KC98.LST"

IF NOT EXIST "%NASM%" GOTO NONASM
IF NOT EXIST "%SRC%" GOTO NOSRC

IF NOT EXIST "%OUTDIR%" (
    MKDIR "%OUTDIR%"
    IF ERRORLEVEL 1 GOTO BAD
)

IF NOT EXIST "%RESDIR%" (
    MKDIR "%RESDIR%"
    IF ERRORLEVEL 1 GOTO BAD
)

IF EXIST "%TMP%" (
    DEL /Q "%TMP%"
    IF ERRORLEVEL 1 GOTO BAD
)

IF EXIST "%OUT%" (
    DEL /Q "%OUT%"
    IF ERRORLEVEL 1 GOTO BAD
)

IF EXIST "%LST%" (
    DEL /Q "%LST%"
    IF ERRORLEVEL 1 GOTO BAD
)

"%NASM%" -v > "%RESDIR%\nasm-version.txt"
IF ERRORLEVEL 1 GOTO BAD

"%NASM%" -Ox -w+all -w+error -f bin ^
  -l "%LST%" ^
  "%SRC%" ^
  -o "%TMP%"

IF ERRORLEVEL 1 GOTO BAD
IF NOT EXIST "%TMP%" GOTO BAD

FOR %%F IN ("%TMP%") DO IF %%~zF EQU 0 GOTO BAD

MOVE /Y "%TMP%" "%OUT%" >NUL
IF ERRORLEVEL 1 GOTO BAD

ECHO built: bin\98\JUY2KC98.COM
ENDLOCAL
EXIT /B 0

:NONASM
ECHO NASM 3.02 not found
ENDLOCAL
EXIT /B 2

:NOSRC
ECHO source file not found
ENDLOCAL
EXIT /B 3

:BAD
IF EXIST "%TMP%" DEL /Q "%TMP%"
IF EXIST "%OUT%" DEL /Q "%OUT%"
ECHO build 98 failed
ENDLOCAL
EXIT /B 1
